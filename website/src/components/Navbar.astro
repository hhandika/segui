---
import cntl from "cntl";
import { Image } from "astro:assets";
import ThemeToggle from "./buttons/ThemeToggle.astro";
import logo from "../assets/logo.svg";
import { docsPath, githubUrl, navItems } from "../data/site";

interface Props {
  /// Let the page show through the bar, as a landing hero does.
  overlay?: boolean;
}

const { overlay = false } = Astro.props;

const currentPath = Astro.url.pathname;
const isActive = (path: string) =>
  path === "/" ? currentPath === "/" : currentPath.startsWith(path);

const navClasses = cntl`
  z-30 flex items-center justify-between
  px-4 py-3 sm:px-6
  ${
    overlay
      ? "sg-nav-overlay fixed inset-x-0 top-0"
      : "sticky top-0 border-b border-leaf-100 bg-white/85 backdrop-blur-md dark:border-leaf-900 dark:bg-[#111613]/85"
  }
`;

const pillClasses = cntl`
  hidden md:flex
  absolute left-1/2 -translate-x-1/2
  items-center gap-1
  rounded-full p-1
  border border-leaf-200/70 dark:border-leaf-800/70
  bg-white/70 dark:bg-leaf-950/60
  shadow-sm backdrop-blur-md
`;

const linkBase = cntl`
  rounded-full px-4 py-1.5
  text-sm font-medium no-underline whitespace-nowrap
  transition-colors
`;

const linkActive = cntl`
  bg-leaf-600 text-white shadow-sm
`;

const linkInactive = cntl`
  text-leaf-900 hover:bg-leaf-100
  dark:text-leaf-100 dark:hover:bg-leaf-900
`;

const docsClasses = cntl`
  hidden sm:inline-flex items-center
  rounded-full px-4 py-1.5
  bg-pollen-300 text-leaf-950
  text-sm font-semibold no-underline
  transition-colors hover:bg-pollen-200
`;

const iconButtonClasses = cntl`
  inline-flex h-9 w-9 items-center justify-center rounded-full
  text-leaf-900 dark:text-leaf-100
  hover:bg-leaf-100 dark:hover:bg-leaf-900
  transition-colors
`;
---

<nav id="site-nav" class={navClasses} aria-label="Global" data-overlay={overlay ? "true" : undefined}>
  <a href="/" class="flex items-center gap-2.5 no-underline">
    <Image src={logo} alt="" width={36} height={36} class="h-9 w-9 rounded-xl shadow-sm" />
    <span class="text-lg font-bold tracking-[0.12em] text-leaf-950 dark:text-leaf-50">SEGUL</span>
  </a>

  <div class={pillClasses}>
    {
      navItems.map(({ path, label }) => (
        <a
          href={path}
          class={cntl`${linkBase} ${isActive(path) ? linkActive : linkInactive}`}
          aria-current={isActive(path) ? "page" : undefined}
        >
          {label}
        </a>
      ))
    }
  </div>

  <div class="flex items-center gap-1.5">
    <a href={docsPath} class={docsClasses}>Docs</a>
    <a href={githubUrl} class={iconButtonClasses} aria-label="SEGUL on GitHub" target="_blank" rel="noopener noreferrer">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"></path>
      </svg>
    </a>
    <ThemeToggle />
    <button
      id="menu-button"
      type="button"
      class={cntl`${iconButtonClasses} md:hidden`}
      aria-label="Open menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>
</nav>

<div id="mobile-menu" class="sg-mobile-menu md:hidden" data-open="false" role="dialog" aria-modal="true" aria-label="Site menu">
  <div id="menu-backdrop" class="sg-menu-backdrop"></div>
  <div class="sg-menu-panel absolute inset-x-0 top-0 rounded-b-3xl bg-white px-6 pt-4 pb-6 shadow-xl dark:bg-leaf-950">
    <div class="mb-6 flex items-center justify-between">
      <span class="text-lg font-bold tracking-[0.12em] text-leaf-950 dark:text-leaf-50">SEGUL</span>
      <button id="close-button" type="button" class={iconButtonClasses} aria-label="Close menu">
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
    <div class="flex flex-col gap-1.5">
      {
        [...navItems, { path: docsPath, label: "Docs" }].map(({ path, label }) => (
          <a
            href={path}
            class={cntl`
              block rounded-xl px-4 py-3 text-base font-semibold no-underline
              ${isActive(path) ? "bg-leaf-600 text-white" : "text-leaf-900 hover:bg-leaf-50 dark:text-leaf-100 dark:hover:bg-leaf-900"}
            `}
          >
            {label}
          </a>
        ))
      }
    </div>
  </div>
</div>

<script>
  const siteNav = document.getElementById("site-nav");

  if (siteNav?.dataset.overlay === "true") {
    const sync = () => siteNav.classList.toggle("sg-nav-scrolled", window.scrollY > 40);
    sync();
    window.addEventListener("scroll", sync, { passive: true });
  }

  const menuButton = document.getElementById("menu-button");
  const mobileMenu = document.getElementById("mobile-menu");

  const setMenu = (open: boolean) => {
    if (!mobileMenu || !menuButton) return;
    mobileMenu.dataset.open = open ? "true" : "false";
    mobileMenu.inert = !open;
    menuButton.setAttribute("aria-expanded", open ? "true" : "false");
    document.documentElement.classList.toggle("sg-menu-open", open);
  };

  setMenu(false);
  menuButton?.addEventListener("click", () => setMenu(mobileMenu?.dataset.open !== "true"));
  document.getElementById("close-button")?.addEventListener("click", () => setMenu(false));
  document.getElementById("menu-backdrop")?.addEventListener("click", () => setMenu(false));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setMenu(false);
  });
</script>
