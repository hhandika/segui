---
/// Official store download badge for SEGUI.
interface Props {
  store: "microsoft" | "mac" | "app" | "play" | "snap";
}

const badges = {
  microsoft: {
    href: "https://apps.microsoft.com/detail/SEGUI/9NP1BQ6FW9PW?mode=direct",
    src: "https://get.microsoft.com/images/en-us%20dark.svg",
    alt: "Get it from Microsoft",
    height: 56,
  },
  mac: {
    href: "https://apps.apple.com/us/app/segui/id6447999874?mt=12&itsct=apps_box_badge&itscg=30200",
    src: "https://tools.applemediaservices.com/api/badges/download-on-the-mac-app-store/black/en-us?size=250x83&releaseDate=1716076800",
    alt: "Download on the Mac App Store",
    height: 56,
  },
  app: {
    href: "https://apps.apple.com/us/app/segui/id6447999874?itsct=apps_box_badge&itscg=30200",
    src: "https://tools.applemediaservices.com/api/badges/download-on-the-app-store/black/en-us?size=250x83&releaseDate=1716076800",
    alt: "Download on the App Store",
    height: 56,
  },
  play: {
    href: "https://play.google.com/store/apps/details?id=com.hhandika.segui&pcampaignid=pcampaignidMKT-Other-global-all-co-prtnr-py-PartBadge-Mar2515-1",
    src: "https://play.google.com/intl/en_us/badges/static/images/badges/en_badge_web_generic.png",
    alt: "Get it on Google Play",
    // The Google Play image includes transparent padding.
    height: 82,
  },
  snap: {
    href: "https://snapcraft.io/segui",
    src: "https://snapcraft.io/static/images/badges/en/snap-store-black.svg",
    alt: "Get it from the Snap Store",
    height: 56,
  },
} as const;

const badge = badges[Astro.props.store];
---

<a class="store-badge" href={badge.href} target="_blank" rel="noopener">
  <img src={badge.src} alt={badge.alt} style={`height: ${badge.height}px`} />
</a>

<style>
  .store-badge {
    display: inline-flex;
    align-items: center;
    height: 82px;
    margin: 0 !important;
  }

  .store-badge img {
    width: auto;
    max-width: 100%;
  }
</style>
