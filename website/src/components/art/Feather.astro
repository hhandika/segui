    fill="#fff"
    d="M476.07,357.84l100.03,173.26c1.88,3.26.77,7.43-2.5,9.31l-31.73,18.32c-3.26,1.88-7.43.77-9.31-2.5l-100.03-173.26c-6.94-12.02-2.82-27.4,9.2-34.34h0c12.02-6.94,27.4-2.82,34.34,9.2ZM325.4,415.8h0c-12.02,6.94-16.14,22.32-9.2,34.34l77.07,133.5c1.88,3.26,6.05,4.38,9.31,2.5l31.73-18.32c3.26-1.88,4.38-6.05,2.5-9.31l-77.07-133.5c-6.94-12.02-22.32-16.14-34.34-9.2ZM209.07,482.96h0c-12.02,6.94-16.14,22.32-9.2,34.34l55.02,95.29c1.88,3.26,6.05,4.38,9.31,2.5l31.73-18.32c3.26-1.88,4.38-6.05,2.5-9.31l-55.02-95.29c-6.94-12.02-22.32-16.14-34.34-9.2Z"
  ></path>
  <path
    fill="#fff"
    d="M185.09,594.2c-12.92-.56-16.77,17.36-4.73,22.08,99.24,38.88,267.51,74.42,387.67-59.95,137.94-154.24,220-184.7,258.3-188.44,7.37-.72,9.69-10.34,3.43-14.32-55.04-34.95-202.05-97.82-356.99,93.23-103.65,127.8-213.81,150.61-287.69,147.4Z"
