---
/// The SEGUL gull drawn for flight: near and far wings that flap, then fold,
/// and legs that drop for landing. Place it inside a group that moves it; the
/// shared timing lives under `.fg-` in `landing.css`.
interface Props {
  /// Drawn width and height in the parent's user units.
  size: number;
  /// Face left instead of right.
  flip?: boolean;
}

const { size, flip = false } = Astro.props;
const colors = "--sk-line: #00391c; --sk-fill: #ffffff; --sk-accent: #ffd64f;";
---

<g transform={flip ? `translate(${size} 0) scale(-1 1)` : undefined}>
  <svg width={size} height={size} viewBox="0 0 96 96" overflow="visible" style={colors} aria-hidden="true">
    <g class="fg-body" fill="none" stroke="var(--sk-line)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
      <g class="fg-far-wing">
        <path d="M60,46 C54,41.5 45,41 35,44 C41,49 51,51 60,48.5 Z" fill="#d7f0e0" stroke-width="2.5"></path>
      </g>
      <path class="fg-legs" d="M58,59.5 V64 M63,59 V64 M56,64 H60 M61,64 H65" stroke-width="2.5"></path>
      <path d="M36,50 C42,46 48,44 56,44 C60,44 63,42 64,38 C65,33 70,31 74,33 C77,35 77,40 75,43 C73,47 72,50 71,54 C69,59 62,61 54,60 C46,59 40,55 36,50 Z" fill="var(--sk-fill)"></path>
      <path d="M76,37.5 L85,39.5 L75.5,42 Z" fill="var(--sk-accent)" stroke-width="2"></path>
      <circle cx="71.5" cy="37" r="1.8" fill="var(--sk-line)" stroke="none"></circle>
      <g class="fg-wing">
        <path d="M62,49 C56,44.5 46,44 35,47 C41,52.5 52,54.5 62,51.5 Z" fill="var(--sk-fill)"></path>
        <path d="M35,47 C38.5,46 42,45.5 45,45.6 L41.5,51 C39,50.2 36.8,48.8 35,47 Z" fill="var(--sk-line)" stroke-width="2"></path>
      </g>
    </g>
  </svg>
</g>
