---
// Static layered diagram for the architecture page. Pass the node list and its
// wide and narrow layouts; the wide layout shows on larger screens.
import { arrowHead, legendOffsets, place, type Layout, type LegendItem, type NodeDef } from "./diagram";

interface Props {
  nodes: NodeDef[];
  wide: Layout;
  narrow: Layout;
  legend: LegendItem[];
  // Text above the dashed line that marks a language or crate boundary.
  boundaryLabel?: string;
  label: string;
  caption: string;
}

const { nodes, wide, narrow, legend, boundaryLabel, label, caption } = Astro.props;
const layouts = [wide, narrow].map((layout) => ({
  ...layout,
  placed: place(nodes, layout),
  legendX: legendOffsets(legend, layout.name === "wide" ? 6.4 : 5.9),
}));
---

<figure class="segul-diagram not-content">
  <div class="card">
    {
      layouts.map((layout) => (
        <svg
          viewBox={`0 0 ${layout.width} ${layout.height}`}
          class={`diagram ${layout.name}`}
          role="img"
          aria-label={label}
        >
          <g>
            {layout.edges.map((e) => (
              <g>
                <line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} class="edge" stroke-width="1.75" />
                {e.arrow !== false && (
                  <polygon points={arrowHead(e.x1, e.y1, e.x2, e.y2)} class="arrow" />
                )}
                {e.label && (
                  <text x={e.x1 + 12} y={(e.y1 + e.y2) / 2 + 4} font-size="11.5" class="edge-label">
                    {e.label}
                  </text>
                )}
              </g>
            ))}
            {layout.boundary && (
              <g>
                <line
                  x1={layout.boundary.x1}
                  x2={layout.boundary.x2}
                  y1={layout.boundary.y}
                  y2={layout.boundary.y}
                  class="boundary"
                  stroke-width="1.25"
                  stroke-dasharray="2 5"
                  stroke-linecap="round"
                />
                {boundaryLabel && (
                  <text
                    x={layout.boundary.x2 - 2}
                    y={layout.boundary.y - 5}
                    text-anchor="end"
                    font-size={layout.name === "wide" ? 11 : 9.5}
                    letter-spacing="0.08em"
                    class="boundary-label"
                  >
                    {boundaryLabel}
                  </text>
                )}
              </g>
            )}
          </g>

          {layout.placed.map((n) => (
            <g class={`node tone-${n.tone}`}>
              <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="14" class="box" stroke-width="1.5" />
              <text
                x={n.x + (n.tone === "app" ? 18 : 14)}
                y={n.y + (n.tone === "app" ? 26 : 24)}
                font-size={n.tone === "app" ? 18 : layout.name === "wide" ? 15 : 14}
                class="title"
              >
                {n.text.title}
              </text>
              {n.text.path && (
                <text
                  x={n.x + 14}
                  y={n.y + 41}
                  font-size={layout.name === "wide" ? 11.5 : 10}
                  class="path"
                >
                  {n.text.path}
                </text>
              )}
              {n.text.sub && (
                <text
                  x={n.x + (n.tone === "app" ? 18 : 14)}
                  y={n.y + (n.tone === "app" ? 45 : 57)}
                  font-size={layout.name === "wide" ? 12 : 11}
                  class="sub"
                >
                  {n.text.sub}
                </text>
              )}
              {n.badge && (
                <g>
                  <rect
                    x={n.x + n.w - n.badge.w - 12}
                    y={n.y + 11}
                    width={n.badge.w}
                    height="18"
                    rx="9"
                    class="badge"
                  />
                  <text
                    x={n.x + n.w - n.badge.w / 2 - 12}
                    y={n.y + 23.5}
                    text-anchor="middle"
                    font-size="9.5"
                    letter-spacing="0.06em"
                    class="badge-text"
                  >
                    {n.badge.label}
                  </text>
                </g>
              )}
              {n.chips.map((c) => (
                <g>
                  <rect x={c.x} y={c.y} width={c.w} height="20" rx="10" class="chip" stroke-width="1" />
                  <text
                    x={c.x + c.w / 2}
                    y={c.y + 14}
                    text-anchor="middle"
                    font-size={layout.name === "wide" ? 11 : 10}
                    class="chip-text"
                  >
                    {c.label}
                  </text>
                </g>
              ))}
            </g>
          ))}

          <g font-size={layout.name === "wide" ? 12 : 11}>
            {legend.map((item, k) => {
              const x = layout.legend.vertical ? layout.legend.x : layout.legend.x + layout.legendX[k];
              const y = layout.legend.vertical ? layout.legend.y + k * 24 : layout.legend.y;
              return (
                <g class={`tone-${item.tone}`}>
                  <rect x={x} y={y - 10} width="12" height="12" rx="3.5" class="swatch" />
                  <text x={x + 20} y={y} class="legend-label">
                    {item.label}
                  </text>
                </g>
              );
            })}
          </g>
        </svg>
      ))
    }
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  /* SEGUL "leaf and pollen" palette, copied from `src/styles/global.css` so
     the diagram does not depend on which Tailwind theme variables are emitted. */
  .segul-diagram {
    --leaf-50: #effdf4;
    --leaf-100: #d8f8e3;
    --leaf-200: #b3efca;
    --leaf-300: #7ce1a6;
    --leaf-400: #3fc87b;
    --leaf-500: #17ad5c;
    --leaf-600: #009245;
    --leaf-700: #00743a;
    --leaf-800: #005c30;
    --leaf-900: #004b29;
    --leaf-950: #002a16;
    --olive-50: #f5f7ef;
    --olive-100: #e8eddb;
    --olive-200: #d1dcb8;
    --olive-300: #b2c48c;
    --olive-400: #93a965;
    --olive-500: #768e48;
    --olive-600: #5e7a3a;
    --olive-700: #475b2e;
    --olive-800: #3a4a28;
    --olive-900: #323f25;
    --olive-950: #182210;
    --pollen-50: #fffbeb;
    --pollen-100: #fff4c7;
    --pollen-200: #ffe98a;
    --pollen-300: #ffd64f;
    --pollen-400: #ffc423;
    --pollen-500: #f9a307;
    --pollen-600: #dd7a02;
    --pollen-700: #b75506;
    --pollen-800: #94410c;
    --pollen-900: #7a360d;
    --pollen-950: #461a02;

    margin: 1.5rem 0;
  }

  .card {
    border: 1px solid rgb(0 42 22 / 0.1);
    border-radius: 1rem;
    background: rgb(255 255 255 / 0.7);
    padding: 0.75rem;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.05);
  }

  .diagram {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--sl-font, sans-serif);
  }

  .diagram.wide {
    display: none;
  }

  @media (min-width: 48rem) {
    .card {
      padding: 1.25rem;
    }
    .diagram.wide {
      display: block;
    }
    .diagram.narrow {
      display: none;
    }
  }

  figcaption {
    margin: 0.75rem auto 0;
    max-width: 48rem;
    text-align: center;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }

  .edge {
    stroke: var(--olive-400);
    stroke-dasharray: 4 5;
  }
  .arrow {
    fill: var(--olive-400);
  }
  .edge-label {
    fill: var(--olive-700);
    font-style: italic;
  }
  .boundary {
    stroke: var(--pollen-600);
  }
  .boundary-label {
    fill: var(--pollen-800);
    font-weight: 600;
  }
  .legend-label {
    fill: var(--leaf-900);
  }

  .title {
    font-weight: 600;
  }
  .path,
  .chip-text {
    font-family: var(--__sl-font-mono, ui-monospace, monospace);
  }
  .sub {
    opacity: 0.9;
  }
  .badge-text {
    font-weight: 700;
  }

  /* Tones: box borders and badges reach 3:1 against the card, and text
     reaches 4.5:1 against its fill, in light and dark themes. */
  .tone-ui {
    --box-fill: var(--leaf-50);
    --box-stroke: var(--leaf-700);
    --title: var(--leaf-950);
    --muted: var(--leaf-800);
    --badge: var(--leaf-700);
    --badge-text: #fff;
    --chip-fill: var(--leaf-100);
    --chip-stroke: var(--leaf-300);
    --chip-text: var(--leaf-900);
    --swatch: var(--leaf-700);
  }
  .tone-rust {
    --box-fill: var(--olive-100);
    --box-stroke: var(--olive-600);
    --title: var(--olive-950);
    --muted: var(--olive-800);
    --badge: var(--olive-700);
    --badge-text: #fff;
    --chip-fill: var(--olive-50);
    --chip-stroke: var(--olive-300);
    --chip-text: var(--olive-900);
    --swatch: var(--olive-600);
  }
  .tone-data {
    --box-fill: var(--pollen-50);
    --box-stroke: var(--pollen-600);
    --title: var(--pollen-950);
    --muted: var(--pollen-800);
    --badge: var(--pollen-700);
    --badge-text: #fff;
    --chip-fill: var(--pollen-100);
    --chip-stroke: var(--pollen-300);
    --chip-text: var(--pollen-900);
    --swatch: var(--pollen-500);
  }
  .tone-app {
    --box-fill: var(--leaf-700);
    --box-stroke: var(--leaf-700);
    --title: #fff;
    --muted: var(--leaf-100);
    --badge: var(--pollen-300);
    --badge-text: var(--pollen-950);
    --chip-fill: var(--leaf-600);
    --chip-stroke: var(--leaf-500);
    --chip-text: #fff;
    --swatch: var(--leaf-700);
  }

  .box {
    fill: var(--box-fill);
    stroke: var(--box-stroke);
  }
  .title {
    fill: var(--title);
  }
  .path,
  .sub {
    fill: var(--muted);
  }
  .badge {
    fill: var(--badge);
  }
  .badge-text {
    fill: var(--badge-text);
  }
  .chip {
    fill: var(--chip-fill);
    stroke: var(--chip-stroke);
  }
  .chip-text {
    fill: var(--chip-text);
  }
  .swatch {
    fill: var(--swatch);
  }

  :global([data-theme="dark"]) .card {
    border-color: rgb(216 248 227 / 0.1);
    background: rgb(0 42 22 / 0.35);
  }
  :global([data-theme="dark"]) .edge {
    stroke: var(--olive-500);
  }
  :global([data-theme="dark"]) .arrow {
    fill: var(--olive-500);
  }
  :global([data-theme="dark"]) .edge-label {
    fill: var(--olive-300);
  }
  :global([data-theme="dark"]) .boundary {
    stroke: var(--pollen-400);
  }
  :global([data-theme="dark"]) .boundary-label {
    fill: var(--pollen-300);
  }
  :global([data-theme="dark"]) .legend-label {
    fill: var(--leaf-100);
  }
  :global([data-theme="dark"]) .tone-ui {
    --box-fill: var(--leaf-950);
    --box-stroke: var(--leaf-500);
    --title: var(--leaf-50);
    --muted: var(--leaf-200);
    --badge: var(--leaf-400);
    --badge-text: var(--leaf-950);
    --chip-fill: var(--leaf-900);
    --chip-stroke: var(--leaf-700);
    --chip-text: var(--leaf-100);
    --swatch: var(--leaf-500);
  }
  :global([data-theme="dark"]) .tone-rust {
    --box-fill: var(--olive-950);
    --box-stroke: var(--olive-400);
    --title: var(--olive-50);
    --muted: var(--olive-200);
    --badge: var(--olive-400);
    --badge-text: var(--olive-950);
    --chip-fill: var(--olive-900);
    --chip-stroke: var(--olive-700);
    --chip-text: var(--olive-100);
    --swatch: var(--olive-400);
  }
  :global([data-theme="dark"]) .tone-data {
    --box-fill: var(--pollen-950);
    --box-stroke: var(--pollen-400);
    --title: var(--pollen-50);
    --muted: var(--pollen-200);
    --badge: var(--pollen-400);
    --badge-text: var(--pollen-950);
    --chip-fill: var(--pollen-900);
    --chip-stroke: var(--pollen-700);
    --chip-text: var(--pollen-100);
    --swatch: var(--pollen-400);
  }
  :global([data-theme="dark"]) .tone-app {
    --box-fill: var(--leaf-800);
    --box-stroke: var(--leaf-400);
    --chip-fill: var(--leaf-700);
    --chip-stroke: var(--leaf-500);
    --swatch: var(--leaf-400);
  }
</style>
