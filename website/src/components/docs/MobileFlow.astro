---
/// How a phone or tablet loads input: pick, copy into the app cache, find
/// matching files, run, and clear. Wraps into a column on narrow screens.
interface Step {
  title: string;
  text: string;
  /// SVG path data drawn in a 24 x 24 box.
  icon: string;
}

const steps: Step[] = [
  {
    title: "Pick",
    text: "Files, folder, archive, or share",
    icon: "M5 12l5 5L20 7",
  },
  {
    title: "Copy or extract",
    text: "Into SEGUI's private cache",
    icon: "M8 8h11v11H8z M5 16V5h11",
  },
  {
    title: "Find matches",
    text: "Only the tool's input format",
    icon: "M11 4a7 7 0 1 1 0 14a7 7 0 1 1 0-14z M16 16l4 4",
  },
  {
    title: "Run task",
    text: "Output goes to the app folder",
    icon: "M8 5v14l11-7z",
  },
  {
    title: "Clear inputs",
    text: "Frees the cached copies",
    icon: "M4 7h16 M9 7V4h6v3 M6 7l1 13h10l1-13",
  },
];
---

<figure class="mf-figure not-content">
  <ol class="mf-steps" aria-label="How SEGUI loads input files on phones and tablets">
    {
      steps.map((step, i) => (
        <li class:list={["mf-step", { "mf-last": i === steps.length - 1 }]}>
          <svg
            class="mf-icon"
            viewBox="0 0 24 24"
            width="24"
            height="24"
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path d={step.icon} />
          </svg>
          <strong>{step.title}</strong>
          <span>{step.text}</span>
        </li>
      ))
    }
  </ol>
  <figcaption>
    iOS and iPadOS open picked folders in place, so they skip the copy step. SEGUI also deletes
    leftover copies at app start.
  </figcaption>
</figure>

<style>
  .mf-figure {
    margin-block: 1.5rem;
    padding: 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: var(--sl-color-gray-7, var(--sl-color-gray-6));
    container-type: inline-size;
  }
  :global(:root:not([data-theme="light"])) .mf-figure {
    background: var(--sl-color-gray-6);
  }
  .mf-steps {
    display: flex;
    gap: 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mf-step {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    padding: 0.75rem 0.5rem;
    border: 1.5px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: var(--sl-color-black);
    text-align: center;
  }
  .mf-step:first-child,
  .mf-last {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
  }
  /* Arrow to the next step. */
  .mf-step:not(.mf-last)::after {
    content: "→";
    position: absolute;
    right: -1.45rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--sl-color-gray-3);
    font-size: 1.25rem;
  }
  .mf-icon {
    fill: none;
    stroke: var(--sl-color-accent-high);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .mf-step strong {
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
  }
  .mf-step span {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    line-height: 1.3;
  }
  .mf-figure figcaption {
    margin-top: 0.75rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    text-align: center;
  }

  /* Stack the steps in narrow columns, with arrows pointing down. */
  @container (max-width: 36rem) {
    .mf-steps {
      flex-direction: column;
      gap: 1.5rem;
    }
    .mf-step {
      flex-basis: auto;
    }
    .mf-step:not(.mf-last)::after {
      content: "↓";
      right: auto;
      left: 50%;
      top: auto;
      bottom: -1.5rem;
      transform: translateX(-50%);
    }
  }
</style>
