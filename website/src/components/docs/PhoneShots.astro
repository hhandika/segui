---
/// A row of phone captures with captions, such as the steps of a tutorial.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  /// Paths under `src/assets/screenshots/`, such as `tutorials/phone-report.webp`.
  shots: string[];
  /// One description per capture.
  alts: string[];
  /// One short caption per capture.
  captions?: string[];
}

const { shots, alts, captions = [] } = Astro.props;

if (shots.length !== alts.length) {
  throw new Error("PhoneShots: shots and alts must have the same length");
}
if (captions.length > 0 && captions.length !== shots.length) {
  throw new Error("PhoneShots: captions must match shots when set");
}

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/screenshots/**/*.{png,jpg,jpeg,webp}",
  { eager: true },
);

const items = shots.map((path, index) => {
  const image = images[`/src/assets/screenshots/${path}`];
  if (!image) {
    throw new Error(`Screenshot not found in src/assets/screenshots: ${path}`);
  }
  return { src: image.default, alt: alts[index], caption: captions[index] };
});
---

<div class="sg-phones not-content">
  {
    items.map((item) => (
      <figure class="sg-phones__item">
        <div class="sg-phones__frame">
          <Image
            src={item.src}
            alt={item.alt}
            widths={[240, 480, 720]}
            sizes="(min-width: 50rem) 240px, 45vw"
          />
        </div>
        {item.caption && <figcaption>{item.caption}</figcaption>}
      </figure>
    ))
  }
</div>

<style>
  .sg-phones {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-block: 1.5rem;
  }

  .sg-phones__item {
    flex: 1 1 9rem;
    max-width: 15rem;
    margin: 0;
  }

  .sg-phones__frame {
    overflow: hidden;
    border: 4px solid var(--sl-color-gray-5);
    border-radius: 1.5rem;
    background: var(--sl-color-gray-6);
  }

  .sg-phones__frame img {
    display: block;
    width: 100%;
    height: auto;
  }

  .sg-phones figcaption {
    margin-top: 0.5rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    line-height: 1.4;
  }
</style>
