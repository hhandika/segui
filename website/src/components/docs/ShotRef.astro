---
interface Props {
  /// Letter of a pin in the page's `<UsageScreenshots>` figure.
  id: string;
}

const { id } = Astro.props;
---

<a class="sg-shot-ref" href="#usage-screenshots" data-shot-ref={id}>{id}</a>

<style>
  .sg-shot-ref {
    display: inline-grid;
    place-items: center;
    min-width: 1.25rem;
    height: 1.25rem;
    margin-inline: 0.125rem;
    padding-inline: 0.3rem;
    vertical-align: 0.125rem;
    border-radius: 0.375rem;
    background: var(--sl-color-accent);
    color: var(--color-leaf-50);
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    scroll-margin-top: calc(var(--sl-nav-height, 4rem) + 6rem);
    transition:
      background-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .sg-shot-ref:hover,
  .sg-shot-ref:focus-visible,
  .sg-shot-ref:global(.is-active) {
    background: var(--color-pollen-400);
    color: var(--color-leaf-950);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-pollen-400) 30%, transparent);
    outline: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .sg-shot-ref {
      transition: none;
    }
  }
</style>
