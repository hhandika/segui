---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  /// Path under `src/assets/screenshots/`, such as `cli/view-align.webp`.
  src: string;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/screenshots/**/*.{png,jpg,jpeg,webp}",
  { eager: true },
);
const image = images[`/src/assets/screenshots/${src}`];
if (!image) {
  throw new Error(`Screenshot not found in src/assets/screenshots: ${src}`);
}
---

<figure class="sg-terminal not-content">
  <Image src={image.default} alt={alt} width={900} densities={[1.5, 2]} quality="high" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .sg-terminal {
    margin-block: 1.25rem 1.75rem;
  }

  .sg-terminal img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 10px;
  }

  .sg-terminal figcaption {
    margin-top: 0.5rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    text-align: center;
  }
</style>
