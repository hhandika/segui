---
/// A straight arrow with an optional label centered above its midpoint.
interface Props {
  x1: number;
  y1: number;
  x2: number;
  y2: number;
  label?: string;
  dashed?: boolean;
}

const { x1, y1, x2, y2, label, dashed = false } = Astro.props;
const angle = Math.atan2(y2 - y1, x2 - x1);
const size = 9;
const back = (offset: number) => [
  x2 - size * Math.cos(angle + offset),
  y2 - size * Math.sin(angle + offset),
];
const [lx, ly] = back(0.45);
const [rx, ry] = back(-0.45);
const [ex, ey] = [x2 - (size - 2) * Math.cos(angle), y2 - (size - 2) * Math.sin(angle)];
---

<g>
  <line x1={x1} y1={y1} x2={ex} y2={ey} class={`fx-line${dashed ? " fx-dashed" : ""}`} />
  <polygon points={`${x2},${y2} ${lx},${ly} ${rx},${ry}`} class="fx-head" />
  {
    label && (
      <text x={(x1 + x2) / 2} y={(y1 + y2) / 2 - 10} text-anchor="middle" class="fx-muted">
        {label}
      </text>
    )
  }
</g>
