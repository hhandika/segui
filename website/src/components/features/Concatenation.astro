---
import Alignment from "./Alignment.astro";
import Arrow from "./Arrow.astro";
import Figure from "./Figure.astro";
import ListCard from "./ListCard.astro";
import { concatTones, locusOne, locusTwo, sampleIds } from "./layout";

const pitch = 18;
const rows = locusOne.map((seq, i) => seq + locusTwo[i]);
const right = 370;
const splitAt = right + locusOne[0].length * pitch;
const end = right + rows[0].length * pitch - 2;
---

<Figure
  id="concatenation"
  viewBox="0 0 720 372"
  title="Alignment concatenation"
  desc="locus_1 has 10 sites and locus_2 has 8 sites for samples seq1 to seq3. Concatenation joins each sample's sequences into one 18-site alignment, with locus_1 at sites 1 to 10 and locus_2 at sites 11 to 18, and writes the partition in RAxML or NEXUS format."
  caption="Rows are matched by sample name, and loci are joined in alphanumeric order."
>
  <Alignment x={56} y={36} rows={locusOne} ids={sampleIds} title="locus_1" tone="l1" cell={16} />
  <Alignment x={56} y={140} rows={locusTwo} ids={sampleIds} title="locus_2" tone="l2" cell={16} />

  <Arrow x1={250} y1={115} x2={310} y2={115} label="concatenate" />

  <Alignment
    x={right}
    y={88}
    rows={rows}
    ids={sampleIds}
    title="concatenated"
    colTones={concatTones}
    cell={16}
  />
  <path d={`M${right},150 v6 H${splitAt - 4} v-6`} class="fx-line" />
  <path d={`M${splitAt},150 v6 H${end} v-6`} class="fx-line" />
  <text x={(right + splitAt) / 2} y="176" text-anchor="middle" class="fx-mono fx-small">
    locus_1 = 1–10
  </text>
  <text x={(splitAt + end) / 2} y="176" text-anchor="middle" class="fx-mono fx-small">
    locus_2 = 11–18
  </text>

  <text x="0" y="222" class="fx-muted">Plus a partition file in the format you choose:</text>
  <ListCard
    x={0}
    y={234}
    w={340}
    title="RAxML partition"
    lines={["DNA, locus_1 = 1-10", "DNA, locus_2 = 11-18"]}
    lineHeight={18}
  />
  <ListCard
    x={370}
    y={234}
    w={340}
    title="NEXUS partition"
    lines={["#NEXUS", "begin sets;", "  charset locus_1 = 1-10;", "  charset locus_2 = 11-18;", "end;"]}
    lineHeight={18}
  />
</Figure>
