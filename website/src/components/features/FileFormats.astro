---
import Chip from "./Chip.astro";
import Figure from "./Figure.astro";
import { chipRow } from "./layout";

const fasta = [".fasta", ".fa", ".fna", ".fsa", ".fas"];
const sections = [
  {
    title: "Alignment and sequence tasks",
    formats: [
      { name: "NEXUS", exts: [".nex", ".nexus", ".nxs"] },
      { name: "FASTA", exts: fasta },
      { name: "Relaxed PHYLIP", exts: [".phy", ".phylip", ".ph"] },
    ],
  },
  {
    title: "Genomic tasks",
    formats: [
      { name: "Reads", exts: [".fastq", ".fq", ".fastq.gz", ".fq.gz"] },
      { name: "Contigs", exts: [...fasta, ".fasta.gz"] },
      { name: "MAF", exts: [".maf", ".maf.gz"] },
      { name: "BED loci", exts: [".bed", ".bed.gz"] },
    ],
  },
];
const rowHeight = 34;
const sectionHeights = sections.map((section) => 40 + section.formats.length * rowHeight + 16);
const sectionTops = sectionHeights.map((_, s) =>
  sectionHeights.slice(0, s).reduce((sum, h) => sum + h, 0),
);
const viewHeight = sectionHeights.reduce((sum, h) => sum + h, 0);
---

<Figure
  id="file-formats"
  viewBox={`0 0 640 ${viewHeight}`}
  title="Supported file extensions"
  desc="Alignment and sequence tasks read NEXUS (.nex, .nexus, .nxs), FASTA (.fasta, .fa, .fna, .fsa, .fas), and relaxed PHYLIP (.phy, .phylip, .ph). Genomic tasks read FASTQ reads (.fastq, .fq, .fastq.gz, .fq.gz), FASTA contigs (.fasta, .fa, .fna, .fsa, .fas, and gzipped such as .fasta.gz), MAF whole-genome alignments (.maf, .maf.gz), and BED loci for MAF conversion (.bed, .bed.gz)."
  caption="Compressed files end in .gz. SEGUL reads them directly, without decompressing them first."
>
  {
    sections.map((section, s) => {
      const top = sectionTops[s];
      return (
        <g>
          <text x="0" y={top + 22} class="fx-title">
            {section.title}
          </text>
          {section.formats.map((format, f) => {
            const y = top + 38 + f * rowHeight;
            const lefts = chipRow(format.exts, 170, 8, true);
            return (
              <g>
                <text x="0" y={y + 12} dominant-baseline="central" class="fx-accent-text">
                  {format.name}
                </text>
                {format.exts.map((ext, e) => (
                  <Chip x={lefts[e]} y={y} text={ext} mono />
                ))}
              </g>
            );
          })}
        </g>
      );
    })
  }
</Figure>
