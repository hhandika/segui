---
import Arrow from "./Arrow.astro";
import FileCard from "./FileCard.astro";

/// One input file turning into a summary table, with the statistics it
/// lists and a note below them. Shared by the read and contig figures.
interface Props {
  input: string;
  inputSub: string;
  output: string;
  outputSub: string;
  stats: string[];
  note: string;
}

const { input, inputSub, output, outputSub, stats, note } = Astro.props;
const y = 8;
---

<g>
  <FileCard x={10} y={y + 10} w={140} name={input} sub={inputSub} stack />
  <Arrow x1={164} y1={y + 42} x2={222} y2={y + 42} />
  <FileCard x={236} y={y + 10} w={150} name={output} sub={outputSub} accent />
  {
    stats.map((stat, s) => (
      <text x="410" y={y + 18 + s * 22} class="fx-small">
        • {stat}
      </text>
    ))
  }
  <text x="410" y={y + 18 + stats.length * 22} class="fx-small fx-accent-text">
    {note}
  </text>
</g>
