---
import Figure from "./Figure.astro";

const groups = [
  {
    name: "Alignments",
    input: "Aligned files or partitions",
    command: "segul align …",
    tools: [
      "Concatenation",
      "Conversion",
      "Distance",
      "Filtering",
      "Partition conversion",
      "Splitting",
      "Summary",
      "Trimming",
      "Unalignment",
    ],
  },
  {
    name: "Genomic",
    input: "Reads, contigs, or MAF",
    command: "segul read|contig|maf …",
    tools: ["Sequence read summary", "Contig summary", "MAF conversion", "MAF summary"],
  },
  {
    name: "Sequences",
    input: "Aligned or unaligned files",
    command: "segul sequence …",
    tools: [
      "Addition",
      "ID extraction",
      "ID mapping",
      "ID renaming",
      "Extraction",
      "Filtering",
      "Removal",
      "Translation",
      "Transposition",
    ],
  },
];
const width = 212;
const toolStep = 25;
const mostTools = Math.max(...groups.map((group) => group.tools.length));
// Room for the header, every tool, and the command at the bottom.
const height = 108 + (mostTools - 1) * toolStep + 44;
---

<Figure
  id="task-groups"
  viewBox={`0 0 660 ${height + 4}`}
  title="SEGUL task groups"
  desc="Three task groups. Alignments takes aligned files or partitions and offers concatenation, conversion, distance, filtering, partition conversion, splitting, summary, trimming, and unalignment. Genomic takes FASTQ reads, FASTA contigs, or MAF whole-genome alignments and offers read and contig summaries plus MAF conversion and summary. Sequences takes aligned or unaligned files and offers addition, ID extraction, mapping, renaming, sequence extraction, filtering, removal, translation, and transposition."
  caption="Each task group is a button in the GUI navigation and a command group in the CLI."
>
  {
    groups.map((group, i) => {
      const x = 2 + i * (width + 12);
      return (
        <g>
          <rect x={x} y="2" width={width} height={height} rx="12" class="fx-panel" />
          <text x={x + 16} y="32" class="fx-title fx-accent-text" style="font-size: 17px">
            {group.name}
          </text>
          <text x={x + 16} y="54" class="fx-muted fx-small">
            Input
          </text>
          <text x={x + 16} y="72" class="fx-small">
            {group.input}
          </text>
          <line x1={x + 16} x2={x + width - 16} y1="86" y2="86" class="fx-line" style="stroke-width: 1; opacity: 0.4" />
          {group.tools.map((tool, t) => (
            <g>
              <circle cx={x + 22} cy={108 + t * toolStep} r="4" class="fx-on" />
              <text x={x + 34} y={108 + t * toolStep} dominant-baseline="central">
                {tool}
              </text>
            </g>
          ))}
          <text x={x + 16} y={height - 12} class="fx-mono fx-muted fx-small">
            {group.command}
          </text>
        </g>
      );
    })
  }
</Figure>
