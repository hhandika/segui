---
/// An illustrated SEGUI window: navigation rail, greeting, and tool cards,
/// following the app's home screen layout.
import Gull from "../art/Gull.astro";
import { categories, tools } from "../../data/site";
import alignments from "../../assets/icons/alignments_outlined.svg";

interface Props {
  class?: string;
  /// Number of tool cards to show.
  count?: number;
}

const { class: className, count = 6 } = Astro.props;
const shown = tools.filter((tool) => tool.category === "alignment").slice(0, count);
const HomeIcon = alignments;
---

<div
  class:list={[
    "overflow-hidden rounded-2xl border border-leaf-200/80 bg-white shadow-2xl shadow-leaf-900/15 dark:border-leaf-800 dark:bg-[#141a16] dark:shadow-black/40",
    className,
  ]}
  role="img"
  aria-label="Illustration of the SEGUI app home screen with alignment tools"
>
  <div class="flex items-center gap-1.5 border-b border-leaf-100 px-4 py-2.5 dark:border-leaf-900">
    <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></span>
    <span class="ml-3 text-xs font-medium text-leaf-900/60 dark:text-leaf-100/50">SEGUI</span>
  </div>
  <div class="flex">
    <div class="hidden w-20 shrink-0 flex-col items-center gap-3 border-r border-leaf-100 py-4 sm:flex dark:border-leaf-900">
      <div class="flex flex-col items-center gap-1">
        <span class="flex h-8 w-14 items-center justify-center rounded-full bg-leaf-100 text-leaf-800 dark:bg-leaf-800 dark:text-leaf-100">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"></path></svg>
        </span>
        <span class="text-[10px] font-semibold text-leaf-900 dark:text-leaf-100">Home</span>
      </div>
      {
        categories.map((category) => {
          const Icon = category.icon;
          return (
            <div class="flex flex-col items-center gap-1 text-leaf-900/70 dark:text-leaf-100/60">
              <span class="flex h-8 w-14 items-center justify-center">
                <Icon class="h-4 w-4" />
              </span>
              <span class="text-[10px] font-medium">{category.label}</span>
            </div>
          );
        })
      }
    </div>
    <div class="min-w-0 flex-1 p-4 sm:p-5">
      <div class="flex items-center justify-between gap-4 rounded-2xl bg-leaf-50 px-4 py-3 dark:bg-leaf-950/70">
        <div>
          <p class="text-xs font-medium text-olive-600 dark:text-olive-300">Good morning</p>
          <p class="text-base font-semibold text-leaf-950 dark:text-leaf-50">What will you analyze today?</p>
        </div>
        <Gull scene class="h-16 w-16 shrink-0" />
      </div>
      <div class="mt-4 flex flex-wrap gap-2 text-[11px] font-medium">
        <span class="inline-flex items-center gap-1 rounded-lg bg-leaf-600 px-2.5 py-1 text-white">
          <HomeIcon class="h-3.5 w-3.5" /> All tools ({tools.length})
        </span>
        <span class="rounded-lg border border-leaf-200 px-2.5 py-1 text-leaf-900 dark:border-leaf-800 dark:text-leaf-100">Workflows</span>
      </div>
      <div class="mt-3 grid grid-cols-1 gap-2.5 sm:grid-cols-2">
        {
          shown.map((tool) => {
            const Icon = tool.icon;
            return (
              <div class="flex gap-3 rounded-xl border border-leaf-100 bg-white p-3 dark:border-leaf-900 dark:bg-[#18201b]">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-leaf-100 text-leaf-800 dark:bg-leaf-900 dark:text-leaf-200">
                  <Icon class="h-5 w-5" />
                </span>
                <div class="min-w-0">
                  <p class="truncate text-xs font-semibold text-leaf-950 dark:text-leaf-50">{tool.title}</p>
                  <p class="mt-0.5 line-clamp-2 text-[11px] leading-snug text-leaf-900/60 dark:text-leaf-100/55">{tool.description}</p>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </div>
</div>
