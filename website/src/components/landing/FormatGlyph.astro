---
/// A small illustration of a file format: sequence cells, read qualities,
/// alignment blocks, or genomic intervals. Lines use `currentColor`.
interface Props {
  glyph: "fasta" | "nexus" | "phylip" | "fastq" | "maf" | "bed" | "partition";
  class?: string;
}

const { glyph, class: className } = Astro.props;
const base: Record<string, string> = {
  A: "#00843f",
  C: "#2565b0",
  G: "#ffc423",
  T: "#c0392b",
  "-": "none",
};
const cell = 6;
const pitch = 7;

/// Cells for a sequence row starting at `x`.
function row(seq: string, x: number, y: number) {
  return [...seq].map((char, i) => ({
    x: x + i * pitch,
    y,
    fill: base[char] ?? "#6b7280",
    gap: char === "-",
  }));
}

const rows: Record<Props["glyph"], { x: number; y: number; fill: string; gap: boolean }[]> = {
  fasta: [...row("AGTCCATGCA", 4, 12), ...row("AGTCGATGCA", 4, 32)],
  nexus: [...row("AGTCCATG", 18, 12), ...row("AGTC-ATG", 18, 21), ...row("AGTCGATG", 18, 30)],
  phylip: [...row("AGTCCATG", 18, 16), ...row("AGTC-ATG", 18, 25), ...row("AGTCGATG", 18, 34)],
  fastq: row("AGTCCATGCA", 4, 8),
  maf: [
    ...row("AGTCC", 4, 6),
    ...row("AGT-C", 4, 14),
    ...row("AGTCC", 4, 22),
    ...row("GATG", 40, 26),
    ...row("GACG", 40, 34),
  ],
  bed: [],
  partition: [...row("AGTCC", 4, 22), ...row("ATGCA", 41, 22)],
};
const qualities = [10, 14, 18, 16, 20, 19, 15, 12, 9, 6];
---

<svg viewBox="0 0 76 46" class={className} aria-hidden="true">
  {glyph === "fasta" && <rect x="4" y="4" width="22" height="3" rx="1.5" fill="currentColor" opacity="0.5" />}
  {glyph === "fasta" && <rect x="4" y="24" width="18" height="3" rx="1.5" fill="currentColor" opacity="0.5" />}
  {
    (glyph === "nexus" || glyph === "phylip") &&
      [0, 1, 2].map((r) => (
        <rect x="4" y={(glyph === "nexus" ? 12 : 16) + r * 9 + 1.5} width="10" height="3" rx="1.5" fill="currentColor" opacity="0.5" />
      ))
  }
  {glyph === "nexus" && <text x="4" y="7" font-size="7" font-weight="700" fill="currentColor" font-family="monospace">#</text>}
  {glyph === "nexus" && <rect x="4" y="40" width="30" height="2.5" rx="1.25" fill="currentColor" opacity="0.35" />}
  {glyph === "phylip" && <text x="4" y="10" font-size="7" font-weight="700" fill="currentColor" font-family="monospace">3 8</text>}
  {
    glyph === "fastq" &&
      qualities.map((q, i) => (
        <rect x={4 + i * pitch} y={40 - q * 1.2} width={cell} height={q * 1.2} rx="1" fill={q >= 12 ? "#3fbf9f" : "#ffd64f"} />
      ))
  }
  {glyph === "maf" && <line x1="38" y1="4" x2="38" y2="42" stroke="currentColor" stroke-width="1" stroke-dasharray="2 2" opacity="0.5" />}
  {
    glyph === "bed" && (
      <g>
        <line x1="4" y1="32" x2="72" y2="32" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.6" />
        {[8, 20, 32, 44, 56, 68].map((x) => (
          <line x1={x} y1="32" x2={x} y2="36" stroke="currentColor" stroke-width="1" opacity="0.5" />
        ))}
        <rect x="8" y="16" width="20" height="9" rx="3" fill="#3fbf9f" />
        <rect x="34" y="10" width="14" height="9" rx="3" fill="#ffd64f" />
        <rect x="52" y="18" width="16" height="9" rx="3" fill="#2565b0" />
      </g>
    )
  }
  {
    glyph === "partition" && (
      <g fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.7">
        <path d="M4,17 v-4 h33 v4" />
        <path d="M41,17 v-4 h33 v4" />
      </g>
    )
  }
  {
    rows[glyph].map((c) =>
      c.gap ? (
        <rect x={c.x + 0.5} y={c.y + 0.5} width={cell - 1} height={cell - 1} rx="1.5" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.4" />
      ) : (
        <rect x={c.x} y={c.y} width={cell} height={cell} rx="1.5" fill={c.fill} />
      ),
    )
  }
</svg>
