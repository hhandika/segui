---
/// The landing page: the app icon's green tile full bleed with the hero art in
/// the `art` slot, then a bento grid of tools.
import AppMockup from "./AppMockup.astro";
import Terminal from "./Terminal.astro";
import FormatGlyph from "./FormatGlyph.astro";
import Gull from "../art/Gull.astro";
import StoreBadges from "../StoreBadges.astro";
import CommandLine from "../CommandLine.astro";
import {
  categories,
  citation,
  docsPath,
  fileFormats,
  interfaces,
  pillars,
  platforms,
  tagline,
  tools,
  workflows,
} from "../../data/site";

const stats = [
  { value: String(tools.length), label: "tools" },
  { value: String(platforms.length), label: "platforms" },
  { value: "0", label: "dependencies" },
];

const kicker =
  "text-xs font-semibold uppercase tracking-[0.2em] text-leaf-600 dark:text-leaf-300";
const sectionTitle =
  "mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-leaf-950 dark:text-leaf-50";
const tile =
  "sg-reveal rounded-3xl border border-leaf-100 bg-leaf-50/60 p-6 dark:border-leaf-900 dark:bg-leaf-950/40";
---

<section
  class="sg-leaf-field relative isolate overflow-hidden px-6 pt-20 pb-24 text-white sm:pt-28"
>
  <div
    class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-[1fr_1.05fr]"
  >
    <div>
      <div class="max-w-xl">
        <h1 class="text-6xl font-black tracking-[0.06em] sm:text-8xl">SEGUL</h1>
        <p
          class="mt-5 text-2xl font-light leading-snug text-leaf-50 sm:text-3xl"
        >
          {tagline}.
        </p>
        <p class="mt-5 text-base leading-relaxed text-leaf-50/80">
          Runs natively on the device you already have, from a phone to a
          computing cluster: iOS, Android, Windows, macOS, and Linux, on ARM and
          x86.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a
            href="/get-started"
            class="rounded-full bg-pollen-300 px-7 py-3.5 font-semibold text-leaf-950 no-underline shadow-lg shadow-black/20 transition-transform hover:-translate-y-0.5 hover:bg-pollen-200"
          >
            Get started
          </a>
          <a
            href={docsPath}
            class="rounded-full border border-white/40 px-7 py-3.5 font-semibold text-white no-underline backdrop-blur-sm transition-colors hover:bg-white/10"
          >
            Read the docs
          </a>
        </div>
      </div>
      <dl class="mt-14 grid max-w-xl grid-cols-3 gap-3">
        {
          stats.map((stat) => (
            <div class="rounded-2xl border border-white/15 bg-white/10 px-4 py-3 backdrop-blur-md">
              <dt class="sr-only">{stat.label}</dt>
              <dd class="text-3xl font-bold">{stat.value}</dd>
              <dd class="text-xs text-leaf-50/75">{stat.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div class="mx-auto w-full max-w-md lg:max-w-none">
      <slot name="art" />
    </div>
  </div>
  <svg
    class="absolute inset-x-0 bottom-0 -z-10 h-16 w-full text-white dark:text-[#111613]"
    viewBox="0 0 1200 64"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path
      d="M0,64 L0,40 C200,10 400,60 600,36 C800,12 1000,52 1200,28 L1200,64 Z"
      fill="currentColor"></path>
  </svg>
</section>

<section class="px-6 py-20 sm:py-24">
  <div class="mx-auto max-w-6xl">
    <p class={kicker}>From raw reads to alignment supermatrix</p>
    <h2 class={sectionTitle}>Prepare phylogenomic datasets in one place.</h2>
    <div class="mt-12 grid auto-rows-auto gap-5 lg:grid-cols-6">
      <div class={`${tile} lg:col-span-4 lg:row-span-2`}>
        <AppMockup count={4} />
      </div>
      {
        categories.map((category) => {
          const CategoryIcon = category.icon;
          const members = tools.filter(
            (tool) => tool.category === category.key,
          );
          return (
            <a
              href={category.docs}
              class={`${tile} group no-underline transition-colors hover:border-leaf-400 lg:col-span-2`}
            >
              <div class="flex items-center justify-between">
                <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-leaf-600 text-white">
                  <CategoryIcon class="h-6 w-6" />
                </span>
                <span class="text-sm font-semibold text-leaf-700 dark:text-leaf-300">
                  {members.length} tools →
                </span>
              </div>
              <h3 class="mt-4 text-lg font-semibold text-leaf-950 dark:text-leaf-50">
                {category.label}
              </h3>
              <p class="text-sm text-leaf-900/65 dark:text-leaf-100/60">
                {category.description}
              </p>
              <div class="mt-4 flex flex-wrap gap-1.5">
                {members.map((tool) => {
                  const Icon = tool.icon;
                  return (
                    <span
                      class="inline-flex items-center gap-1.5 rounded-full bg-white px-2.5 py-1 text-xs font-medium text-leaf-900 ring-1 ring-leaf-100 dark:bg-leaf-950 dark:text-leaf-100 dark:ring-leaf-900"
                      title={tool.description}
                    >
                      <Icon class="h-3.5 w-3.5" />
                      {tool.title.replace(
                        / (alignments|sequences|sequence IDs|genomic)/,
                        "",
                      )}
                    </span>
                  );
                })}
              </div>
            </a>
          );
        })
      }
      <div
        class={`${tile} lg:col-span-4 bg-[#0b120e]! border-leaf-900! p-0! overflow-hidden`}
      >
        <Terminal class="rounded-3xl! border-0! shadow-none!" />
      </div>
    </div>
  </div>
</section>

<section class="px-6 pb-20 sm:pb-24">
  <div class="mx-auto max-w-6xl">
    <p class={kicker}>File formats</p>
    <h2 class={sectionTitle}>Support for various sequence formats.</h2>
    <ul class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4 lg:grid-cols-7">
      {
        fileFormats.map((format) => (
          <li class="sg-reveal flex flex-col rounded-2xl border border-leaf-100 p-4 dark:border-leaf-900">
            <FormatGlyph
              glyph={format.glyph}
              class="h-12 w-20 text-leaf-700 dark:text-leaf-300"
            />
            <h3 class="mt-3 flex items-center gap-1.5 font-semibold text-leaf-950 dark:text-leaf-50">
              {format.name}
              {format.gzip && (
                <span
                  class="rounded-full bg-pollen-300 px-1.5 py-0.5 font-mono text-[10px] font-bold leading-none text-leaf-950"
                  title="Also reads gzipped files"
                >
                  .gz
                </span>
              )}
            </h3>
            <p class="text-xs text-leaf-900/65 dark:text-leaf-100/60">
              {format.role}
            </p>
            <p class="mt-2 font-mono text-[11px] text-leaf-700 dark:text-leaf-300">
              {format.exts.join(" ")}
            </p>
          </li>
        ))
      }
    </ul>
    <a
      href="/docs/features/#supported-file-extensions"
      class="mt-6 inline-block text-sm font-semibold text-leaf-700 no-underline hover:underline dark:text-leaf-300"
      >All supported extensions →</a
    >
  </div>
</section>

<section class="px-6 pb-20 sm:pb-24">
  <div class="mx-auto max-w-6xl">
    <p class={kicker}>Guided workflows</p>
    <h2 class={sectionTitle}>
      Common data summary, cleaning, and shaping tasks.
    </h2>
    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      {
        workflows.map((workflow) => (
          <div class="sg-reveal flex flex-col gap-3 rounded-2xl border border-leaf-100 p-5 dark:border-leaf-900">
            <h3 class="font-semibold text-leaf-950 dark:text-leaf-50">
              {workflow.title}
            </h3>
            <ol class="flex flex-wrap items-center gap-2 text-sm">
              {workflow.steps.map((step, index) => (
                <li class="flex items-center gap-2">
                  {index > 0 && (
                    <span class="text-pollen-500" aria-hidden="true">
                      →
                    </span>
                  )}
                  <span class="rounded-full bg-leaf-100 px-3 py-1 font-medium text-leaf-800 dark:bg-leaf-900 dark:text-leaf-100">
                    {step}
                  </span>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="bg-leaf-50 px-6 py-20 sm:py-24 dark:bg-leaf-950/50">
  <div class="mx-auto grid max-w-6xl gap-6 md:grid-cols-3">
    {
      pillars.map((pillar) => (
        <div class="sg-reveal">
          <div class="h-1.5 w-12 rounded-full bg-linear-to-r from-pollen-300 to-ribbon-teal" />
          <h3 class="mt-5 text-xl font-semibold text-leaf-950 dark:text-leaf-50">
            {pillar.title}
          </h3>
          <p class="mt-2 leading-relaxed text-leaf-900/75 dark:text-leaf-100/70">
            {pillar.description}
          </p>
        </div>
      ))
    }
  </div>
</section>

<section class="px-6 py-20 sm:py-24">
  <div class="mx-auto max-w-6xl">
    <p class={kicker}>Interfaces</p>
    <h2 class={sectionTitle}>One core, three ways in.</h2>
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {
        interfaces.map((item) => (
          <div class="sg-reveal flex flex-col rounded-3xl border border-leaf-100 p-6 dark:border-leaf-900">
            <p class="text-sm font-bold tracking-widest text-leaf-600 dark:text-leaf-300">
              {item.name}
            </p>
            <h3 class="mt-2 text-xl font-semibold text-leaf-950 dark:text-leaf-50">
              {item.title}
            </h3>
            <p class="mt-2 flex-1 text-leaf-900/75 dark:text-leaf-100/70">
              {item.description}
            </p>
            {item.command && (
              <CommandLine command={item.command} class="mt-4" />
            )}
            <a
              href={item.href}
              class="mt-5 text-sm font-semibold text-leaf-700 no-underline hover:underline dark:text-leaf-300"
            >
              Installation guide →
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="px-6 pb-24">
  <div
    class="sg-leaf-field relative mx-auto max-w-6xl overflow-hidden rounded-4xl px-8 py-12 text-white sm:px-12"
  >
    <div class="grid items-center gap-8 lg:grid-cols-[1fr_auto]">
      <div>
        <h2 class="text-3xl font-bold sm:text-4xl">Install SEGUI, free.</h2>
        <p class="mt-3 max-w-xl text-leaf-50/80">
          Desktop, tablet, and phone. Looking for the command line? <a
            href="/docs/installation/intro/"
            class="font-semibold text-pollen-300 underline"
            >See every install option</a
          >.
        </p>
        <StoreBadges
          tone="brand"
          stores={["microsoft", "app", "play", "snap"]}
        />
        <p class="mt-6 text-xs leading-relaxed text-leaf-50/70">
          {citation.text}
          <a href={citation.doi} class="underline">{citation.doi}</a>
        </p>
      </div>
      <div class="hidden rounded-full bg-white/95 p-6 lg:block">
        <Gull scene class="h-40 w-40" />
      </div>
    </div>
  </div>
</section>
