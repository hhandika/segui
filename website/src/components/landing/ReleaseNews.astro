---
/// Latest release news: a short summary beside a before and after speed chart.
/// All bars share one seconds scale, so their lengths compare across tasks.
import { latestRelease } from "../../data/site";

const {
  version,
  previousVersion,
  summary,
  href,
  highlights,
  benchmarks,
  benchmarkNote,
} = latestRelease;
const longest = Math.max(...benchmarks.map((item) => item.before));
const width = (seconds: number) => `${(seconds / longest) * 100}%`;
const series = [
  { key: "before", label: previousVersion, bar: "bg-pollen-500 dark:bg-pollen-700" },
  { key: "after", label: version, bar: "bg-leaf-700 dark:bg-leaf-400" },
] as const;
---

<section class="px-6 pt-16 sm:pt-20">
  <div
    class="sg-reveal mx-auto grid max-w-6xl items-center gap-8 rounded-3xl border border-leaf-100 bg-leaf-50/60 p-6 sm:p-8 lg:grid-cols-[1fr_1.15fr] lg:gap-12 dark:border-leaf-900 dark:bg-leaf-950/40"
  >
    <div>
      <p
        class="text-xs font-semibold uppercase tracking-[0.2em] text-leaf-600 dark:text-leaf-300"
      >
        News
      </p>
      <h2
        class="mt-3 text-2xl font-bold tracking-tight text-leaf-950 sm:text-3xl dark:text-leaf-50"
      >
        SEGUL {version} is here
      </h2>
      <p class="mt-3 text-leaf-900/75 dark:text-leaf-100/70">{summary}</p>
      <ul class="mt-4 flex flex-wrap gap-2">
        {
          highlights.map((item) => (
            <li>
              <a
                href={item.href}
                class="inline-block rounded-full bg-white px-3 py-1 text-sm font-medium text-leaf-900 no-underline ring-1 ring-leaf-100 transition-colors hover:ring-leaf-400 dark:bg-leaf-950 dark:text-leaf-100 dark:ring-leaf-900"
              >
                {item.title}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href={href}
        class="mt-5 inline-block text-sm font-semibold text-leaf-700 no-underline hover:underline dark:text-leaf-300"
      >
        What's new in {version} →
      </a>
    </div>

    <figure>
      <figcaption class="flex flex-wrap items-center justify-between gap-2">
        <span class="text-sm font-semibold text-leaf-950 dark:text-leaf-50">
          Execution time (s)
        </span>
        <span
          class="flex gap-4 text-xs text-leaf-900/70 dark:text-leaf-100/65"
          aria-hidden="true"
        >
          {
            series.map((item) => (
              <span class="flex items-center gap-1.5">
                <span class={`h-2.5 w-2.5 rounded-sm ${item.bar}`} />
                {item.label}
              </span>
            ))
          }
        </span>
      </figcaption>
      <dl class="mt-4 space-y-4">
        {
          benchmarks.map((item) => (
            <div>
              <dt class="text-sm text-leaf-900/80 dark:text-leaf-100/75">
                {item.dataset}
              </dt>
              <dd class="mt-1.5 space-y-0.5">
                {series.map((run) => (
                  <div
                    class="flex items-center gap-2"
                    title={`${run.label}: ${item[run.key].toFixed(2)} s`}
                  >
                    <span class="min-w-0 flex-1">
                      <span
                        class={`block h-2.5 rounded-e ${run.bar}`}
                        style={{ width: width(item[run.key]) }}
                      />
                    </span>
                    <span class="w-12 shrink-0 text-right font-mono text-xs text-leaf-900/75 dark:text-leaf-100/70">
                      <span class="sr-only">{run.label}: </span>
                      {item[run.key].toFixed(2)} s
                    </span>
                  </div>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-4 text-xs text-leaf-900/65 dark:text-leaf-100/60">
        {benchmarkNote}
      </p>
    </figure>
  </div>
</section>
