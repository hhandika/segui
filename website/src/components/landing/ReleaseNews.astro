---
/// Latest release news: a short summary beside a screenshot of the release.
import { Image } from "astro:assets";
import { latestRelease } from "../../data/site";

const { version, summary, href, highlights, screenshot } = latestRelease;
---

<section class="px-6 pt-16 sm:pt-20">
  <div
    class="sg-reveal mx-auto grid grid-cols-1 max-w-6xl items-center gap-8 rounded-3xl border border-leaf-100 bg-leaf-50/60 p-6 sm:p-8 lg:grid-cols-[1fr_1.15fr] lg:gap-12 dark:border-leaf-900 dark:bg-leaf-950/40"
  >
    <div>
      <p
        class="text-xs font-semibold uppercase tracking-[0.2em] text-leaf-600 dark:text-leaf-300"
      >
        News
      </p>
      <h2
        class="mt-3 text-2xl font-bold tracking-tight text-leaf-950 sm:text-3xl dark:text-leaf-50"
      >
        SEGUL {version} is here
      </h2>
      <p class="mt-3 text-leaf-900/75 dark:text-leaf-100/70">{summary}</p>
      <ul class="mt-4 flex flex-wrap gap-2">
        {
          highlights.map((item) => (
            <li>
              <a
                href={item.href}
                class="inline-block rounded-full bg-white px-3 py-1 text-sm font-medium text-leaf-900 no-underline ring-1 ring-leaf-100 transition-colors hover:ring-leaf-400 dark:bg-leaf-950 dark:text-leaf-100 dark:ring-leaf-900"
              >
                {item.title}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href={href}
        class="mt-5 inline-block text-sm font-semibold text-leaf-700 no-underline hover:underline dark:text-leaf-300"
      >
        What's new in {version} →
      </a>
    </div>

    <figure class="mx-auto w-full max-w-xs">
      <!-- Border and shadow match AppMockup in the bento grid, with Android
           status and gesture bars instead of window controls. The bars use the
           app's background color so they blend into the screenshot. -->
      <div
        class="overflow-hidden rounded-2xl border border-leaf-200/80 bg-[#ddeadd] shadow-2xl shadow-leaf-900/15 dark:border-leaf-800 dark:shadow-black/40"
      >
        <div class="flex items-center justify-between px-4 pt-2 pb-1 text-[11px] font-medium text-leaf-950/80" aria-hidden="true">
          <span>10:34</span>
          <span class="flex items-center gap-1">
            <svg class="h-3 w-3" viewBox="0 0 24 24" fill="currentColor"><path d="M12 20 1 8a16 16 0 0 1 22 0z"></path></svg>
            <svg class="h-3 w-3" viewBox="0 0 24 24" fill="currentColor"><path d="M2 22 22 2v20z"></path></svg>
            <svg class="h-3 w-3" viewBox="0 0 24 24" fill="currentColor"><path d="M9 2h6v2h2v18H7V4h2z"></path></svg>
          </span>
        </div>
        <Image
          src={screenshot.src}
          alt={screenshot.alt}
          widths={[320, 640]}
          sizes="(min-width: 1024px) 320px, 80vw"
          class="block w-full"
        />
        <div class="flex justify-center py-2" aria-hidden="true">
          <span class="h-1 w-24 rounded-full bg-leaf-950/70"></span>
        </div>
      </div>
      <figcaption class="mt-4 text-center text-xs text-leaf-900/65 dark:text-leaf-100/60">
        {screenshot.caption}
      </figcaption>
    </figure>
  </div>
</section>
