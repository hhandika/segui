---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { LinkCard } from "@astrojs/starlight/components";
import { formatDate, getPosts, postSlug } from "../../utils/blog";

const posts = await getPosts();
---

<StarlightPage
  frontmatter={{
    title: "News",
    description: "Release notes and updates for SEGUL.",
  }}
>
  {
    posts.map((post) => (
      <LinkCard
        title={post.data.title}
        description={`${formatDate(post.data.date)} · ${post.data.description}`}
        href={`/blog/${postSlug(post)}/`}
      />
    ))
  }
</StarlightPage>
