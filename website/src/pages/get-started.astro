---
import Layout from "../layouts/Layout.astro";
import Feather from "../components/art/Feather.astro";
import StoreBadges from "../components/StoreBadges.astro";
import CommandLine from "../components/CommandLine.astro";
import { platforms, workflows } from "../data/site";

const kicker = "text-xs font-semibold uppercase tracking-[0.2em] text-olive-600 dark:text-olive-300";
const sectionTitle = "mt-3 text-3xl font-bold tracking-tight text-leaf-950 sm:text-4xl dark:text-leaf-50";
const card = "sg-reveal rounded-3xl border border-leaf-100 bg-white p-6 sm:p-8 dark:border-leaf-900 dark:bg-[#141a16]";

const cliOptions = [
  { label: "Bioconda (Linux and macOS)", command: "conda install bioconda::segul", href: "/docs/installation/install_conda/" },
  { label: "Cargo (any platform with Rust)", command: "cargo install segul", href: "/docs/installation/install_cargo/" },
  { label: "Pre-built binary (Linux and macOS)", command: "curl -fsSL https://segul.app/install.sh | sh", href: "/docs/installation/install_binary/" },
];

const apiOptions = [
  { label: "Python", command: "pip install pysegul", href: "/docs/api-usage/python/intro/" },
  { label: "Rust", command: "cargo add segul", href: "/docs/api-usage/rust-api/" },
  { label: "R", command: "", href: "/docs/api-usage/r-api/" },
];

const datasets = [
  { label: "FASTA", href: "https://github.com/hhandika/segul/raw/main/examples/data-fasta.zip" },
  { label: "NEXUS", href: "https://github.com/hhandika/segul/raw/main/examples/data-nexus.zip" },
  { label: "PHYLIP", href: "https://github.com/hhandika/segul/raw/main/examples/data-phylip.zip" },
  { label: "Concatenated NEXUS", href: "https://github.com/hhandika/segul/raw/main/examples/data-concat-nex.zip" },
];
---

<Layout title="Get Started | SEGUL" description="Install SEGUL and run your first phylogenomic analysis.">
  <section class="sg-leaf-field relative isolate overflow-hidden px-6 pt-16 pb-20 text-white sm:pt-24">
    <Feather class="pointer-events-none absolute -right-40 -bottom-16 -z-10 w-[28rem] max-w-none opacity-20 lg:right-[-2rem] lg:top-20 lg:bottom-auto lg:w-[26rem] lg:opacity-90 xl:right-[4%]" />
    <div class="mx-auto max-w-6xl">
      <p class="text-xs font-semibold uppercase tracking-[0.25em] text-pollen-300">Get started</p>
      <h1 class="mt-4 max-w-2xl text-4xl font-bold tracking-tight sm:text-5xl">
        From install to your first supermatrix.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-leaf-50/85">
        Pick the interface that fits how you work. Every interface runs the same phylogenomic tools, so you can switch at any time.
      </p>
    </div>
  </section>

  <section class="px-6 py-16">
    <div class="mx-auto max-w-6xl">
      <p class={kicker}>Step 1</p>
      <h2 class={sectionTitle}>Install SEGUL</h2>
      <div class="mt-10 grid gap-6 lg:grid-cols-3">
        <div class={card}>
          <span class="rounded-md bg-pollen-200 px-2 py-0.5 text-xs font-bold tracking-wider text-leaf-950">GUI</span>
          <h3 class="mt-4 text-xl font-semibold text-leaf-950 dark:text-leaf-50">SEGUI app</h3>
          <p class="mt-2 text-leaf-900/75 dark:text-leaf-100/70">
            Best for most users. Point-and-click tools on desktop, tablet, and phone.
          </p>
          <StoreBadges stores={["microsoft", "app", "play", "snap"]} />
          <a href="/docs/installation/install_gui/" class="text-sm font-semibold text-leaf-700 no-underline hover:underline dark:text-leaf-300">System requirements and other downloads →</a>
        </div>
        <div class={card}>
          <span class="rounded-md bg-pollen-200 px-2 py-0.5 text-xs font-bold tracking-wider text-leaf-950">CLI</span>
          <h3 class="mt-4 text-xl font-semibold text-leaf-950 dark:text-leaf-50">Command line</h3>
          <p class="mt-2 text-leaf-900/75 dark:text-leaf-100/70">
            Best for pipelines, clusters, and very large datasets.
          </p>
          <ul class="mt-5 space-y-5">
            {
              cliOptions.map((option) => (
                <li>
                  <a href={option.href} class="text-sm font-semibold text-leaf-950 no-underline hover:text-leaf-600 dark:text-leaf-50 dark:hover:text-leaf-300">{option.label} →</a>
                  {option.command && <CommandLine command={option.command} class="mt-3" />}
                </li>
              ))
            }
          </ul>
        </div>
        <div class={card}>
          <span class="rounded-md bg-pollen-200 px-2 py-0.5 text-xs font-bold tracking-wider text-leaf-950">API</span>
          <h3 class="mt-4 text-xl font-semibold text-leaf-950 dark:text-leaf-50">Library</h3>
          <p class="mt-2 text-leaf-900/75 dark:text-leaf-100/70">
            Best for building SEGUL into your own analysis code.
          </p>
          <ul class="mt-5 space-y-5">
            {
              apiOptions.map((option) => (
                <li>
                  <a href={option.href} class="text-sm font-semibold text-leaf-950 no-underline hover:text-leaf-600 dark:text-leaf-50 dark:hover:text-leaf-300">{option.label} →</a>
                  {option.command && <CommandLine command={option.command} class="mt-3" />}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-leaf-50/70 px-6 py-16 dark:bg-leaf-950/40">
    <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-2">
      <div>
        <p class={kicker}>Step 2</p>
        <h2 class={sectionTitle}>Try an example dataset</h2>
        <p class="mt-4 text-leaf-900/75 dark:text-leaf-100/70">
          Small alignment datasets in every supported format, ready for a first run.
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          {
            datasets.map((dataset) => (
              <a href={dataset.href} class="rounded-full border border-leaf-300 bg-white px-4 py-2 text-sm font-semibold text-leaf-800 no-underline transition-colors hover:bg-leaf-600 hover:text-white dark:border-leaf-700 dark:bg-leaf-950 dark:text-leaf-100">
                {dataset.label} ↓
              </a>
            ))
          }
        </div>
      </div>
      <div>
        <p class={kicker}>Step 3</p>
        <h2 class={sectionTitle}>Follow a workflow</h2>
        <ul class="mt-6 space-y-3">
          {
            workflows.map((workflow) => (
              <li class="rounded-2xl border border-leaf-100 bg-white p-4 dark:border-leaf-900 dark:bg-[#141a16]">
                <p class="font-semibold text-leaf-950 dark:text-leaf-50">{workflow.title}</p>
                <p class="mt-1 text-sm text-leaf-900/70 dark:text-leaf-100/65">{workflow.steps.join(" → ")}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="px-6 py-16">
    <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[1fr_1.1fr]">
      <div>
        <p class={kicker}>Platforms</p>
        <h2 class={sectionTitle}>Where SEGUL runs</h2>
        <p class="mt-4 text-leaf-900/75 dark:text-leaf-100/70">
          Native builds for ARM and x86 CPUs. Not sure which to choose? Read <a href="/docs/cli_gui/" class="font-semibold text-leaf-700 underline dark:text-leaf-300">CLI vs GUI</a>.
        </p>
      </div>
      <div class="overflow-x-auto rounded-2xl border border-leaf-100 dark:border-leaf-900">
        <table class="w-full text-left text-sm">
          <thead class="bg-leaf-50 text-xs uppercase tracking-wider text-leaf-700 dark:bg-leaf-950 dark:text-leaf-300">
            <tr><th class="px-5 py-3">Platform</th><th class="px-5 py-3">GUI</th><th class="px-5 py-3">CLI</th></tr>
          </thead>
          <tbody class="divide-y divide-leaf-100 dark:divide-leaf-900">
            {
              platforms.map((platform) => (
                <tr class="text-leaf-950 dark:text-leaf-50">
                  <td class="px-5 py-2.5 font-medium">{platform.name}</td>
                  <td class="px-5 py-2.5">{platform.gui ? "Yes" : "—"}</td>
                  <td class="px-5 py-2.5">{platform.cli ? "Yes" : "—"}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="px-6 pb-20">
    <div class="sg-leaf-field mx-auto flex max-w-6xl flex-col items-start gap-6 rounded-4xl px-8 py-10 text-white sm:flex-row sm:items-center sm:justify-between sm:px-12">
      <div>
        <h2 class="text-2xl font-bold">Ready for the details?</h2>
        <p class="mt-2 text-leaf-50/80">The quick start walks through every interface with examples.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="/docs/quick_start/" class="rounded-full bg-pollen-300 px-6 py-3 font-semibold text-leaf-950 no-underline hover:bg-pollen-200">Quick start</a>
        <a href="/docs/support/" class="rounded-full border border-white/40 px-6 py-3 font-semibold text-white no-underline hover:bg-white/10">Get help</a>
      </div>
    </div>
  </section>
</Layout>
